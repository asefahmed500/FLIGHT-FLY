generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin
}

enum BookingStatus {
  pending
  approved
  rejected
  cancelled
}

enum BookingItemType {
  flight
  hotel
  tour
  package
  visa
  ticket
}

enum PaymentType {
  card
  invoice
}

model User {
  uid         String   @id
  email       String   @unique
  displayName String?
  photoURL    String?
  role        UserRole @default(customer)
  createdAt   DateTime @default(now())

  bookings      Booking[]
  favorites     Favorite[]
  notifications Notification[]
}

model Booking {
  id            String           @id @default(cuid())
  refId         String           @unique
  userId        String
  userEmail     String
  passengerName String
  email         String
  phone         String?
  itemTitle     String
  itemType      BookingItemType
  price         String
  cabinClass    String
  paymentType   PaymentType
  travelDate    String?
  guests        Int?
  nationality   String?
  passportNumber String?
  specialRequests String?
  status        BookingStatus    @default(pending)
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  dealId       String
  dealTitle    String
  dealPrice    String
  dealImage    String?
  dealCategory String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@unique([userId, dealId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}
